# Put this file at .env.local and configure actual installed models.
# Never commit real API keys.
RENDERING_ENGINE=COMFYUI
COMFYUI_API_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=comfyui/workflow-api.json
COMFYUI_CHECKPOINT_NAME=YOUR_INSTALLED_CHECKPOINT.safetensors
COMFYUI_STYLE_LORA_NAME=YOUR_INSTALLED_WEBTOON_STYLE.safetensors
COMFYUI_STYLE_LORA_STRENGTH=0.8
COMFYUI_STYLE_LORA_CLIP_STRENGTH=0.8
COMFYUI_NEGATIVE_PROMPT=speech bubbles, text, watermark
LLM_ENGINE=OPENAI
LLM_OPENAI_API_BASE_URL=http://127.0.0.1:8000/v1
LLM_OPENAI_API_MODEL=YOUR_SERVED_STORY_LORA_MODEL_ID
AUTH_OPENAI_API_KEY=local
NEXT_PUBLIC_ENABLE_COMMUNITY_SHARING=false
ENABLE_HUGGING_FACE_OAUTH=false
ENABLE_HUGGING_FACE_OAUTH_WALL=false
