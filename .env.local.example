# Colab T4 model stack: load only one GPU workload at a time.
# The model filenames below are pinned choices; download weights separately.
RENDERING_ENGINE=COMFYUI
COMFYUI_API_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=comfyui/workflow-api.json
COMFYUI_CHECKPOINT_NAME=Illustrious-XL-v2.0.safetensors
# Optional: not present until a LoRA is trained and installed for Illustrious XL v2.
COMFYUI_STYLE_LORA_NAME=
COMFYUI_STYLE_LORA_STRENGTH=0.8
COMFYUI_STYLE_LORA_CLIP_STRENGTH=0.8
COMFYUI_NEGATIVE_PROMPT=speech bubbles, text, watermark, logo
LLM_ENGINE=OPENAI
LLM_OPENAI_API_BASE_URL=http://127.0.0.1:8000/v1
# This is the llama.cpp served model ID; GGUF filename: Qwen3.5-9B-Q4_K_M.gguf
LLM_OPENAI_API_MODEL=Qwen3.5-9B
# llama.cpp --lora <converted_story_adapter.gguf> if/when trained.
AUTH_OPENAI_API_KEY=local
NEXT_PUBLIC_ENABLE_COMMUNITY_SHARING=false
ENABLE_HUGGING_FACE_OAUTH=false
ENABLE_HUGGING_FACE_OAUTH_WALL=false

# Use a persistent mounted directory in Colab
WEBTOON_DATA_DIR=./webtoon-data

# Required when using character/reference images in the new renderQueuedPanel pipeline
COMFYUI_REFERENCE_BINDINGS_PATH=comfyui/reference-bindings.json
